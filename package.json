{
  "name": "openerp",
  "version": "2.1.0",
  "private": true,
  "description": "Type-safe ERP for industrial electrical & instrumentation (EC&I) contracting: rate buildup, service code recipes, job lifecycle and invoicing.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:check": "node scripts/db-check.mjs",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:push": "node scripts/prisma-cli.mjs db push",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:migrate": "node server/scripts/apply-migrations.mjs",
    "db:restore-fixture": "node scripts/restore-baseline-fixture.mjs",
    "seed": "npm run seed --workspace server",
    "smoke:phase2": "node scripts/smoke-phase2.mjs",
    "lint": "eslint . && oxlint .",
    "lint:fix": "eslint . --fix && oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspace server",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci",
    "smoke:phase3": "node scripts/smoke-phase3.mjs",
    "smoke:phase4": "node scripts/smoke-phase4.mjs",
    "smoke:phase5": "node scripts/smoke-phase5.mjs",
    "smoke:phase6": "node scripts/smoke-phase6.mjs",
    "smoke:phase7": "node scripts/smoke-phase7.mjs",
    "smoke:phase13": "node scripts/smoke-phase13.mjs",
    "check:docker": "node scripts/check-docker.mjs",
    "import:template": "tsx server/scripts/generate-template.ts",
    "import:data": "tsx server/scripts/import-data.ts"
  },
  "overrides": {
    "mysql2": "^3.24.6",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.13.0",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
