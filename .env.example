# ---------------------------------------------------------------------------
# OpenERP environment template.  Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DB_HOST=192.168.50.7
DB_PORT=5432
DB_NAME=openerp-dev
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=

# Full connection string. Prisma does not expand ${VAR} references, so the value
# below must be written out in full (keep it quoted).
DATABASE_URL="postgresql://postgres:CHANGE_ME@192.168.50.7:5432/openerp-dev?schema=public"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Public URL of the Next.js client, used for CORS and cookie policy.
CLIENT_ORIGIN=http://localhost:3000

# Absolute origin the browser uses for API calls.
#
# Leave this EMPTY to make requests same-origin on /api/* (requires the dev
# rewrite proxy in client/next.config.mjs). Set it to the API's absolute origin
# to call the API directly instead.
#
# Direct calls are safe because localhost:3000 and localhost:4000 are the same
# *site* — the port is not part of the site calculation — so a SameSite=Lax
# session cookie is still sent. The API allows the origin via CLIENT_ORIGIN.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth / sessions ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=
AUTH_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=openerp_session
# Set true when serving over HTTPS (locks cookies to Secure).
AUTH_COOKIE_SECURE=false

# --- Bootstrap super admin (used once by `npm run seed`) -------------------
SEED_ADMIN_EMAIL=admin@contractor.co.za
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System
SEED_ADMIN_SURNAME=Administrator

# --- Demo accounts (one per non-admin role) ---------------------------------
# Creates david.m@ / sipho.z@ / bongani.d@ (matched to existing employees),
# plus pm@ and billing@. All share the single password below, so this exists to
# exercise the RBAC matrix during development and is refused outright when
# NODE_ENV=production. Leave blank to skip. Rotate each account via
# POST /api/auth/change-password before sharing the environment.
#
# Quote any value containing '#' or a space. An unquoted '#' starts a comment,
# so SEED_DEMO_PASSWORD=Ops#Field2026 silently becomes "Ops" and is then rejected
# by the password policy as too short.
SEED_DEMO_PASSWORD=""

# --- Pricing / billing defaults -------------------------------------------
DEFAULT_CURRENCY=ZAR
DEFAULT_VAT_RATE=0.15