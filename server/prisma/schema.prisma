// OpenERP Prisma schema
//
// Phase 1 (v0.1.0) — models the 18 pre-existing baseline tables plus the
// auth/RBAC tables introduced by this phase.
//
// Notes on the baseline database:
//  * Every enum is mapped explicitly. Several DB enum labels contain spaces and
//    dots (e.g. '00. Cancelled', 'P1 - Emergency / Breakdown'), which are not
//    legal Prisma identifiers, so each variant uses a safe name + @map.
//  * All 18 baseline tables already use `GENERATED ALWAYS AS IDENTITY` primary
//    keys whose sequences are correctly advanced, so `@default(autoincrement())`
//    matches the live database exactly and no id migration was needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum JobStatus {
  JOB_CANCELLED             @map("00. Cancelled")
  JOB_SCOPING               @map("01. Scoping")
  JOB_SCOPED                @map("01A. Scoped")
  JOB_AWAITING_PO           @map("02. Awaiting PO")
  JOB_WNYS                  @map("03. WNYS")
  JOB_WIP                   @map("04. WIP")
  JOB_WORK_COMPLETE         @map("05. Work Complete")
  JOB_ACTUALS_IN_PROGRESS   @map("06. Actuals in Progress")
  JOB_PACK_READY            @map("07. Pack Ready")
  JOB_OUT_FOR_SIGNATURE     @map("08. Out for signature")
  JOB_AWAITING_CHANGE_ORDER @map("09. Awaiting change order")
  JOB_INVOICED              @map("10. Invoiced")
  JOB_PARTIALLY_INVOICED    @map("11. Partially Invoiced")

  @@map("job_status_enum")
}

enum JobPriority {
  P1_EMERGENCY_BREAKDOWN @map("P1 - Emergency / Breakdown")
  P2_URGENT              @map("P2 - Urgent")
  P3_ROUTINE_NORMAL      @map("P3 - Routine / Normal")
  P4_PLANNED_SHUTDOWN    @map("P4 - Planned Shutdown")
  P5_LOW                 @map("P5 - Low")

  @@map("job_priority_enum")
}

enum ServiceCodeCategory {
  ACTIVITY    @map("Activity")
  R1_MATERIAL @map("R1 Material")

  @@map("service_code_category_enum")
}

enum ShiftType {
  NT @map("NT")
  OT @map("OT1.5")
  DT @map("DT2.0")
  NS @map("NS")
  ST @map("ST")

  @@map("shift_type_enum")
}

enum ContractAmendmentStatus {
  DRAFT            @map("Draft")
  PENDING_APPROVAL @map("Pending Approval")
  ACTIVE           @map("Active")
  SUPERSEDED       @map("Superseded")
  TERMINATED       @map("Terminated")

  @@map("contract_amendment_status_enum")
}

enum AmendmentType {
  BASE_AGREEMENT       @map("Base Agreement")
  ANNUAL_ESCALATION    @map("Annual Escalation")
  SCOPE_CHANGE         @map("Scope Change")
  CPI_INDEX_ADJUSTMENT @map("CPI / Index Adjustment")
  AD_HOC_REVISION      @map("Ad-Hoc Revision")

  @@map("amendment_type_enum")
}

enum CostParameterCategory {
  PPE             @map("PPE")
  TRANSPORT       @map("Transport")
  EQUIPMENT       @map("Equipment")
  OVERHEADS       @map("Overheads")
  MARGIN          @map("Margin")
  MATERIAL_MARKUP @map("Material Markup")

  @@map("cost_parameter_category_enum")
}

enum InvoiceStatus {
  DRAFT          @map("Draft")
  SUBMITTED      @map("Submitted")
  APPROVED       @map("Approved")
  PARTIALLY_PAID @map("Partially Paid")
  PAID           @map("Paid")
  DISPUTED       @map("Disputed")
  CANCELLED      @map("Cancelled")

  @@map("invoice_status_enum")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Broker {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(150)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived Boolean @default(false) @map("is_archived")

  employees Employee[]

  @@map("broker")
}

model EmployeeContractType {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(100)
  isArchived Boolean @default(false) @map("is_archived")

  employees Employee[]

  @@map("employee_contract_type")
}

model Employee {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  surname        String    @db.VarChar(100)
  mobile         String?   @db.VarChar(50)
  email          String?   @unique @db.VarChar(255)
  idNumber       String?   @unique @map("id_number") @db.VarChar(50)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  brokerId       Int?      @map("broker_id")
  contractTypeId Int       @map("contract_type_id")
  managerId      Int?      @map("manager_id")
  rate           Decimal?  @db.Decimal(10, 2)

  broker       Broker?              @relation(fields: [brokerId], references: [id])
  contractType EmployeeContractType @relation(fields: [contractTypeId], references: [id])
  manager      Employee?            @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]           @relation("EmployeeManager")

  supervisedJobs Job[]           @relation("JobSupervisor")
  jobAssignments JobAssignment[]
  appUser        AppUser?

  @@index([brokerId])
  @@index([contractTypeId])
  @@index([managerId])
  @@map("employee")
}

model Client {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(150)
  email           String     @unique @db.VarChar(255)
  address         String?
  /// When false, invoices must not charge VAT (effective rate is forced to 0).
  isVatRegistered Boolean    @default(true) @map("is_vat_registered")
  /// SARS VAT number, 10 digits. Printed on tax invoices.
  vatNumber       String?    @map("vat_number") @db.VarChar(50)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived      Boolean    @default(false) @map("is_archived")
  contacts        Contact[]
  contracts       Contract[]

  @@map("client")
}

model Contact {
  id     Int     @id @default(autoincrement())
  clientId Int   @map("client_id")
  name     String @db.VarChar(150)
  mobile   String? @db.VarChar(50)
  email    String? @db.VarChar(255)
  /// Phase 8 item 4: e.g. "Accounts receivable", "Site contact", "Signatory".
  role        String? @db.VarChar(100)
  isArchived  Boolean @default(false) @map("is_archived")

  client Client @relation(fields: [clientId], references: [id])
  jobs   Job[]

  @@index([clientId])
  @@map("contact")
}

// ---------------------------------------------------------------------------
// Commercial
// ---------------------------------------------------------------------------

model Contract {
  id          Int     @id @default(autoincrement())
  clientId    Int     @map("client_id")
  number      String  @unique @db.VarChar(100)
  description String
  type        String? @db.VarChar(100)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived  Boolean @default(false) @map("is_archived")

  client     Client              @relation(fields: [clientId], references: [id])
  amendments ContractAmendment[]
  projects   Project[]

  @@index([clientId])
  @@map("contract")
}

model ContractAmendment {
  id              Int                     @id @default(autoincrement())
  contractId      Int                     @map("contract_id")
  amendmentNumber String                  @map("amendment_number") @db.VarChar(50)
  amendmentType   AmendmentType           @default(ANNUAL_ESCALATION) @map("amendment_type")
  effectiveDate   DateTime                @map("effective_date") @db.Date
  expiryDate      DateTime?               @map("expiry_date") @db.Date
  status          ContractAmendmentStatus @default(ACTIVE)
  signedDate      DateTime?               @map("signed_date") @db.Date
  notes           String?
  /// Default VAT fraction for invoices under this amendment (0.1500 = 15%).
  /// Snapshotted onto each invoice at generation time.
  vatRate         Decimal                 @default(0.15) @map("vat_rate") @db.Decimal(5, 4)
  isArchived      Boolean                 @default(false) @map("is_archived")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  contract           Contract                @relation(fields: [contractId], references: [id])
  costParameters     ContractCostParameter[]
  serviceMasterRates ServiceMasterRate[]
  serviceCodes       ServiceCode[]
  projects           Project[]
  jobs               Job[]

  @@unique([contractId, amendmentNumber])
  @@index([contractId])
  @@map("contract_amendment")
}

model ContractCostParameter {
  id            Int                   @id @default(autoincrement())
  amendmentId   Int                   @map("amendment_id")
  category      CostParameterCategory
  parameterName String                @map("parameter_name") @db.VarChar(100)
  numericValue  Decimal               @map("numeric_value") @db.Decimal(12, 6)
  uom           String                @db.VarChar(50)
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment ContractAmendment @relation(fields: [amendmentId], references: [id])

  @@unique([amendmentId, parameterName])
  @@index([amendmentId])
  @@map("contract_cost_parameters")
}

/// Tier 1 labour master rates.
///
/// Per ADR-001 the `overheadCost` / `sgaCost` / `profitCost` / `fullLoadedRate`
/// columns are AUTHORITATIVE once written. They seed from
/// `ContractCostParameter` values when a rate card is built, but they are not
/// recomputed afterwards, so historic contracts and the invoiced
/// `applied_rate` snapshots stay reproducible.
model ServiceMasterRate {
  id                    Int       @id @default(autoincrement())
  amendmentId           Int       @map("amendment_id")
  serviceMasterCode     String    @map("service_master_code") @db.VarChar(20)
  labourType            String    @map("labour_type") @db.VarChar(100)
  shiftType             ShiftType @default(NT) @map("shift_type")
  uom                   String    @default("per Hour") @db.VarChar(30)
  bargainingCouncilDesc String?   @map("bargaining_council_desc") @db.VarChar(150)

  councilRate        Decimal? @map("council_rate") @db.Decimal(10, 2)
  customRate         Decimal? @map("custom_rate") @db.Decimal(10, 2)
  wagePremiumPct     Decimal  @default(0) @map("wage_premium_pct") @db.Decimal(5, 4)
  manInPocket        Decimal  @map("man_in_pocket") @db.Decimal(10, 2)
  leavePay           Decimal  @map("leave_pay") @db.Decimal(10, 2)
  totalStatutoryCost Decimal  @map("total_statutory_cost") @db.Decimal(10, 2)
  ppeCost            Decimal  @map("ppe_cost") @db.Decimal(10, 2)
  transportCost      Decimal  @map("transport_cost") @db.Decimal(10, 2)
  equipmentCost      Decimal  @map("equipment_cost") @db.Decimal(10, 2)
  overheadCost       Decimal  @map("overhead_cost") @db.Decimal(10, 2)
  sgaCost            Decimal  @map("sga_cost") @db.Decimal(10, 2)
  profitCost         Decimal  @map("profit_cost") @db.Decimal(10, 2)
  fullLoadedRate     Decimal  @map("full_loaded_rate") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment   ContractAmendment       @relation(fields: [amendmentId], references: [id])
  labourItems ServiceCodeLabourItem[]

  @@unique([amendmentId, labourType, shiftType])
  @@unique([amendmentId, serviceMasterCode, shiftType])
  @@index([amendmentId])
  @@map("service_master_rates")
}

/// Tier 2 service code master — an Activity recipe or an R1 material BOM.
model ServiceCode {
  id                 Int                 @id @default(autoincrement())
  amendmentId        Int                 @map("amendment_id")
  code               String              @db.VarChar(50)
  description        String
  category           ServiceCodeCategory @default(ACTIVITY)
  uom                String              @db.VarChar(20)
  materialMarkupPct  Decimal             @default(0) @map("material_markup_pct") @db.Decimal(5, 4)
  calculatedUnitRate Decimal             @default(0) @map("calculated_unit_rate") @db.Decimal(12, 4)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment       ContractAmendment         @relation(fields: [amendmentId], references: [id])
  labourItems     ServiceCodeLabourItem[]
  materialItems   ServiceCodeMaterialItem[]
  jobServiceCodes JobServiceCode[]
  invoiceItems    InvoiceItem[]

  @@unique([amendmentId, code])
  @@index([amendmentId])
  @@map("service_code")
}

model ServiceCodeLabourItem {
  id                  Int     @id @default(autoincrement())
  serviceCodeId       Int     @map("service_code_id")
  serviceMasterRateId Int     @map("service_master_rate_id")
  crewQuantity        Decimal @default(1) @map("crew_quantity") @db.Decimal(8, 2)
  hoursPerUnit        Decimal @map("hours_per_unit") @db.Decimal(10, 4)
  lineSubtotal        Decimal @map("line_subtotal") @db.Decimal(12, 4)

  serviceCode       ServiceCode       @relation(fields: [serviceCodeId], references: [id])
  serviceMasterRate ServiceMasterRate @relation(fields: [serviceMasterRateId], references: [id])

  @@unique([serviceCodeId, serviceMasterRateId])
  @@index([serviceCodeId])
  @@map("service_code_labour_item")
}

model ServiceCodeMaterialItem {
  id            Int     @id @default(autoincrement())
  serviceCodeId Int     @map("service_code_id")
  itemCode      String? @map("item_code") @db.VarChar(50)
  description   String
  supplierName  String? @map("supplier_name") @db.VarChar(150)
  unitCost      Decimal @map("unit_cost") @db.Decimal(12, 4)
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  uom           String  @default("EA") @db.VarChar(20)
  subtotalCost  Decimal @map("subtotal_cost") @db.Decimal(12, 4)

  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])

  @@index([serviceCodeId])
  @@map("service_code_material_item")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model Project {
  id          Int       @id @default(autoincrement())
  contractId  Int       @map("contract_id")
  amendmentId Int       @map("amendment_id")
  code        String    @unique @db.VarChar(50)
  year        Int       @db.SmallInt
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?

  contract  Contract          @relation(fields: [contractId], references: [id])
  amendment ContractAmendment @relation(fields: [amendmentId], references: [id])
  jobs      Job[]

  @@index([contractId])
  @@index([amendmentId])
  @@map("project")
}

model Job {
  id              Int         @id @default(autoincrement())
  projectId       Int         @map("project_id")
  /// Null means "inherit the project's amendment" (Phase 3 resolution rule).
  amendmentId     Int?        @map("amendment_id")
  supervisorId    Int?        @map("supervisor_id")
  clientContactId Int?        @map("client_contact_id")
  status          JobStatus   @default(JOB_SCOPING)
  priority        JobPriority @default(P3_ROUTINE_NORMAL)

  workOrder                 String?   @map("work_order") @db.VarChar(100)
  workOrderReceivedDate     DateTime? @map("work_order_received_date") @db.Date
  purchaseOrder             String?   @map("purchase_order") @db.VarChar(100)
  purchaseOrderReceivedDate DateTime? @map("purchase_order_received_date") @db.Date
  plannedStartDate          DateTime? @map("planned_start_date") @db.Date
  plannedEndDate            DateTime? @map("planned_end_date") @db.Date
  actualStartDate           DateTime? @map("actual_start_date") @db.Date
  actualEndDate             DateTime? @map("actual_end_date") @db.Date
  area                      String?   @db.VarChar(100)
  description               String?

  project       Project            @relation(fields: [projectId], references: [id])
  amendment     ContractAmendment? @relation(fields: [amendmentId], references: [id])
  supervisor    Employee?          @relation("JobSupervisor", fields: [supervisorId], references: [id])
  clientContact Contact?           @relation(fields: [clientContactId], references: [id])
  serviceCodes  JobServiceCode[]
  assignments   JobAssignment[]
  invoices      Invoice[]

  @@index([projectId])
  @@index([amendmentId])
  @@index([supervisorId])
  @@index([status])
  @@map("job")
}

model JobServiceCode {
  id              Int     @id @default(autoincrement())
  jobId           Int     @map("job_id")
  serviceCodeId   Int     @map("service_code_id")
  plannedQuantity Decimal @default(0) @map("planned_quantity") @db.Decimal(10, 2)
  actualQuantity  Decimal @default(0) @map("actual_quantity") @db.Decimal(10, 2)
  /// Immutable pricing snapshot taken at scoping time.
  appliedRate     Decimal @map("applied_rate") @db.Decimal(12, 4)
  plannedSubtotal Decimal @map("planned_subtotal") @db.Decimal(12, 2)
  actualSubtotal  Decimal @default(0) @map("actual_subtotal") @db.Decimal(12, 2)
  /// Phase 8 item 6: the inputs that produced `appliedRate`, captured at scoping
  /// time - service code, markup, every labour and material line, and the
  /// amendment's cost parameters. `appliedRate` makes the number reproducible;
  /// this makes it defensible. Null only on rows backfilled before the column
  /// existed, and on backfilled rows it carries `"backfilled": true`.
  snapshotSource  Json?   @map("snapshot_source") @db.JsonB

  job         Job         @relation(fields: [jobId], references: [id])
  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])

  @@unique([jobId, serviceCodeId])
  @@index([jobId])
  @@index([serviceCodeId])
  @@map("job_service_code")
}

model JobAssignment {
  id           Int       @id @default(autoincrement())
  jobId        Int       @map("job_id")
  employeeId   Int       @map("employee_id")
  role         String?   @db.VarChar(100)
  assignedDate DateTime? @map("assigned_date") @db.Date

  job      Job      @relation(fields: [jobId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([jobId])
  @@index([employeeId])
  /// Phase 8 item 1: one crew slot per person per job, enforced by the database.
  /// Every sibling join table already had this; `job_assignment` did not, and the
  /// Phase 7 crew screen made a duplicate one click away.
  @@unique([jobId, employeeId], map: "job_assignment_job_employee_key")
  @@map("job_assignment")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id            Int           @id @default(autoincrement())
  jobId         Int           @map("job_id")
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  issueDate     DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(DRAFT)
  /// Legacy pre-VAT column: equals `totalWithTax` for new invoices.
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)

  // --- VAT (migration 0002) ---------------------------------------------
  /// Sum of rounded line subtotals, VAT exclusive.
  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(14, 2)
  /// VAT fraction snapshotted from the amendment at generation time.
  taxRate        Decimal @default(0.15) @map("tax_rate") @db.Decimal(5, 4)
  /// subtotalAmount x effective tax rate, rounded to cents.
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// subtotalAmount + taxAmount. The amount payable.
  totalWithTax   Decimal @default(0) @map("total_with_tax") @db.Decimal(14, 2)
  // -----------------------------------------------------------------------

  notes String?

  job   Job           @relation(fields: [jobId], references: [id])
  items InvoiceItem[]

  @@index([jobId])
  @@index([status])
  @@map("invoice")
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int     @map("invoice_id")
  serviceCodeId  Int     @map("service_code_id")
  description    String?
  billedQuantity Decimal @default(1) @map("billed_quantity") @db.Decimal(10, 2)
  /// Immutable pricing snapshot copied from `job_service_code.applied_rate`.
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 4)
  subtotal       Decimal @db.Decimal(12, 2)

  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])

  @@index([invoiceId])
  @@index([serviceCodeId])
  @@map("invoice_item")
}

// ---------------------------------------------------------------------------
// Authentication & RBAC (introduced in Phase 1)
// ---------------------------------------------------------------------------

/// Every application user is linked 1-to-1 to an `employee` record. There are
/// no accounts without an employee, and no employees may hold two accounts.
model AppUser {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @unique @map("employee_id")
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  /// Bumped on password change / forced logout to invalidate old tokens.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee      @relation(fields: [employeeId], references: [id])
  roles    AppUserRole[]
  auditEntries AuditLog[]

  @@index([isActive])
  @@map("app_user")
}

model AppRole {
  id          Int      @id @default(autoincrement())
  /// Stable machine key, e.g. 'administrator', 'commercial_qs'.
  key         String   @unique @db.VarChar(64)
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users       AppUserRole[]
  permissions RolePermission[]

  @@map("app_role")
}

// ---------------------------------------------------------------------------
// Audit log (introduced in Phase 5)
// ---------------------------------------------------------------------------

/// Append-only record of every write to application data.
///
/// Actor fields are denormalised deliberately: `actorUserId` is cleared when an
/// account is deleted, but the log must keep naming who acted. `before`/`after`
/// hold the row as JSON, and on an UPDATE `after` carries only the fields that
/// actually changed, so a reviewer sees the edit rather than the whole row.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actorUserId     Int?    @map("actor_user_id")
  actorEmail      String? @map("actor_email") @db.VarChar(255)
  actorEmployeeId Int?    @map("actor_employee_id")

  action    String @db.VarChar(16)
  model     String @db.VarChar(64)
  /// Primary key of the affected row, or a comma-separated list for bulk writes.
  recordId  String? @map("record_id")
  summary   String?

  before         Json?    @map("before")
  after          Json?    @map("after")
  changedFields  String[] @map("changed_fields")

  requestId String? @map("request_id") @db.VarChar(64)
  route     String? @db.VarChar(255)
  method    String? @db.VarChar(10)

  actor     AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([model])
  @@index([actorUserId])
  @@index([model, recordId])
  @@map("audit_log")
}

model AppUserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy Int?     @map("assigned_by")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("app_user_role")
}

/// A single named capability, e.g. 'contract:write' or 'job:transition:invoiced'.
model Permission {
  id          Int     @id @default(autoincrement())
  /// Dotted machine key, e.g. 'job.transition.submit'.
  key         String  @unique @db.VarChar(100)
  description String?
  /// Workflow grouping used by the Phase 5 permissions matrix UI.
  category    String  @db.VarChar(64)

  roles RolePermission[]

  @@index([category])
  @@map("permission")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}
