// OpenERP Prisma schema
//
// Phase 1 (v0.1.0) — models the 18 pre-existing baseline tables plus the
// auth/RBAC tables introduced by this phase.
//
// Notes on the baseline database:
//  * Every enum is mapped explicitly. Several DB enum labels contain spaces and
//    dots (e.g. '00. Cancelled', 'P1 - Emergency / Breakdown'), which are not
//    legal Prisma identifiers, so each variant uses a safe name + @map.
//  * All 18 baseline tables already use `GENERATED ALWAYS AS IDENTITY` primary
//    keys whose sequences are correctly advanced, so `@default(autoincrement())`
//    matches the live database exactly and no id migration was needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum JobPriority {
  P1_EMERGENCY_BREAKDOWN @map("P1 - Emergency / Breakdown")
  P2_URGENT              @map("P2 - Urgent")
  P3_ROUTINE_NORMAL      @map("P3 - Routine / Normal")
  P4_PLANNED_SHUTDOWN    @map("P4 - Planned Shutdown")
  P5_LOW                 @map("P5 - Low")

  @@map("job_priority_enum")
}

enum ServiceCodeCategory {
  ACTIVITY    @map("Activity")
  R1_MATERIAL @map("R1 Material")

  @@map("service_code_category_enum")
}

enum ShiftType {
  NT @map("NT")
  OT @map("OT1.5")
  DT @map("DT2.0")
  NS @map("NS")
  ST @map("ST")

  @@map("shift_type_enum")
}

enum ContractAmendmentStatus {
  DRAFT            @map("Draft")
  PENDING_APPROVAL @map("Pending Approval")
  ACTIVE           @map("Active")
  SUPERSEDED       @map("Superseded")
  TERMINATED       @map("Terminated")

  @@map("contract_amendment_status_enum")
}

enum AmendmentType {
  BASE_AGREEMENT       @map("Base Agreement")
  ANNUAL_ESCALATION    @map("Annual Escalation")
  SCOPE_CHANGE         @map("Scope Change")
  CPI_INDEX_ADJUSTMENT @map("CPI / Index Adjustment")
  AD_HOC_REVISION      @map("Ad-Hoc Revision")

  @@map("amendment_type_enum")
}

enum CostParameterCategory {
  PPE             @map("PPE")
  TRANSPORT       @map("Transport")
  EQUIPMENT       @map("Equipment")
  OVERHEADS       @map("Overheads")
  MARGIN          @map("Margin")
  MATERIAL_MARKUP @map("Material Markup")

  @@map("cost_parameter_category_enum")
}

enum InvoiceStatus {
  DRAFT          @map("Draft")
  SUBMITTED      @map("Submitted")
  APPROVED       @map("Approved")
  PARTIALLY_PAID @map("Partially Paid")
  PAID           @map("Paid")
  DISPUTED       @map("Disputed")
  CANCELLED      @map("Cancelled")

  @@map("invoice_status_enum")
}

/// Phase 16. Internal workflow states, not a business-owned pipeline, so this
/// stays an enum rather than the admin-editable catalogue that job statuses
/// became in Phase 15.
enum TimesheetStatus {
  DRAFT     @map("Draft")
  SUBMITTED @map("Submitted")
  APPROVED  @map("Approved")
  REJECTED  @map("Rejected")

  @@map("timesheet_status_enum")
}

/// Phase 17. Only DM is created today; the others exist so job/project channels
/// are additive later rather than a rewrite.
enum ConversationKind {
  DM      @map("DM")
  JOB     @map("JOB")
  PROJECT @map("PROJECT")
  GROUP   @map("GROUP")

  @@map("conversation_kind_enum")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Broker {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(150)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived Boolean @default(false) @map("is_archived")

  employees Employee[]

  @@map("broker")
}

model EmployeeContractType {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(100)
  isArchived Boolean @default(false) @map("is_archived")

  employees Employee[]

  @@map("employee_contract_type")
}

model Employee {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  surname        String    @db.VarChar(100)
  mobile         String?   @db.VarChar(50)
  email          String?   @unique @db.VarChar(255)
  idNumber       String?   @unique @map("id_number") @db.VarChar(50)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  brokerId       Int?      @map("broker_id")
  contractTypeId Int       @map("contract_type_id")
  managerId      Int?      @map("manager_id")
  rate           Decimal?  @db.Decimal(10, 2)

  broker       Broker?              @relation(fields: [brokerId], references: [id])
  contractType EmployeeContractType @relation(fields: [contractTypeId], references: [id])
  manager      Employee?            @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]           @relation("EmployeeManager")

  supervisedJobs Job[]           @relation("JobSupervisor")
  jobAssignments JobAssignment[]
  timesheets     Timesheet[]
  appUser        AppUser?

  @@index([brokerId])
  @@index([contractTypeId])
  @@index([managerId])
  @@map("employee")
}

model Client {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(150)
  email           String     @unique @db.VarChar(255)
  address         String?
  /// When false, invoices must not charge VAT (effective rate is forced to 0).
  isVatRegistered Boolean    @default(true) @map("is_vat_registered")
  /// SARS VAT number, 10 digits. Printed on tax invoices.
  vatNumber       String?    @map("vat_number") @db.VarChar(50)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived      Boolean    @default(false) @map("is_archived")
  contacts        Contact[]
  contracts       Contract[]

  @@map("client")
}

model Contact {
  id     Int     @id @default(autoincrement())
  clientId Int   @map("client_id")
  name     String @db.VarChar(150)
  mobile   String? @db.VarChar(50)
  email    String? @db.VarChar(255)
  /// Phase 8 item 4: e.g. "Accounts receivable", "Site contact", "Signatory".
  role        String? @db.VarChar(100)
  isArchived  Boolean @default(false) @map("is_archived")

  client Client @relation(fields: [clientId], references: [id])
  jobs   Job[]

  @@index([clientId])
  @@map("contact")
}

// ---------------------------------------------------------------------------
// Commercial
// ---------------------------------------------------------------------------

model Contract {
  id          Int     @id @default(autoincrement())
  clientId    Int     @map("client_id")
  number      String  @unique @db.VarChar(100)
  description String
  type        String? @db.VarChar(100)
  /// Phase 8 item 3: archived, not deleted. See ADR-008.
  isArchived  Boolean @default(false) @map("is_archived")

  client     Client              @relation(fields: [clientId], references: [id])
  amendments ContractAmendment[]
  projects   Project[]

  @@index([clientId])
  @@map("contract")
}

model ContractAmendment {
  id              Int                     @id @default(autoincrement())
  contractId      Int                     @map("contract_id")
  amendmentNumber String                  @map("amendment_number") @db.VarChar(50)
  amendmentType   AmendmentType           @default(ANNUAL_ESCALATION) @map("amendment_type")
  effectiveDate   DateTime                @map("effective_date") @db.Date
  expiryDate      DateTime?               @map("expiry_date") @db.Date
  status          ContractAmendmentStatus @default(ACTIVE)
  signedDate      DateTime?               @map("signed_date") @db.Date
  notes           String?
  /// Default VAT fraction for invoices under this amendment (0.1500 = 15%).
  /// Snapshotted onto each invoice at generation time.
  vatRate         Decimal                 @default(0.15) @map("vat_rate") @db.Decimal(5, 4)
  isArchived      Boolean                 @default(false) @map("is_archived")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  contract           Contract                @relation(fields: [contractId], references: [id])
  costParameters     ContractCostParameter[]
  serviceMasterRates ServiceMasterRate[]
  serviceCodes       ServiceCode[]
  projects           Project[]
  jobs               Job[]

  @@unique([contractId, amendmentNumber])
  @@index([contractId])
  @@map("contract_amendment")
}

model ContractCostParameter {
  id            Int                   @id @default(autoincrement())
  amendmentId   Int                   @map("amendment_id")
  category      CostParameterCategory
  parameterName String                @map("parameter_name") @db.VarChar(100)
  numericValue  Decimal               @map("numeric_value") @db.Decimal(12, 6)
  uom           String                @db.VarChar(50)
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment ContractAmendment @relation(fields: [amendmentId], references: [id])

  @@unique([amendmentId, parameterName])
  @@index([amendmentId])
  @@map("contract_cost_parameters")
}

/// Tier 1 labour master rates.
///
/// Per ADR-001 the `overheadCost` / `sgaCost` / `profitCost` / `fullLoadedRate`
/// columns are AUTHORITATIVE once written. They seed from
/// `ContractCostParameter` values when a rate card is built, but they are not
/// recomputed afterwards, so historic contracts and the invoiced
/// `applied_rate` snapshots stay reproducible.
model ServiceMasterRate {
  id                    Int       @id @default(autoincrement())
  amendmentId           Int       @map("amendment_id")
  serviceMasterCode     String    @map("service_master_code") @db.VarChar(20)
  labourType            String    @map("labour_type") @db.VarChar(100)
  shiftType             ShiftType @default(NT) @map("shift_type")
  uom                   String    @default("per Hour") @db.VarChar(30)
  bargainingCouncilDesc String?   @map("bargaining_council_desc") @db.VarChar(150)

  councilRate        Decimal? @map("council_rate") @db.Decimal(10, 2)
  customRate         Decimal? @map("custom_rate") @db.Decimal(10, 2)
  wagePremiumPct     Decimal  @default(0) @map("wage_premium_pct") @db.Decimal(5, 4)
  manInPocket        Decimal  @map("man_in_pocket") @db.Decimal(10, 2)
  leavePay           Decimal  @map("leave_pay") @db.Decimal(10, 2)
  totalStatutoryCost Decimal  @map("total_statutory_cost") @db.Decimal(10, 2)
  ppeCost            Decimal  @map("ppe_cost") @db.Decimal(10, 2)
  transportCost      Decimal  @map("transport_cost") @db.Decimal(10, 2)
  equipmentCost      Decimal  @map("equipment_cost") @db.Decimal(10, 2)
  overheadCost       Decimal  @map("overhead_cost") @db.Decimal(10, 2)
  sgaCost            Decimal  @map("sga_cost") @db.Decimal(10, 2)
  profitCost         Decimal  @map("profit_cost") @db.Decimal(10, 2)
  fullLoadedRate     Decimal  @map("full_loaded_rate") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment   ContractAmendment       @relation(fields: [amendmentId], references: [id])
  labourItems ServiceCodeLabourItem[]

  @@unique([amendmentId, labourType, shiftType])
  @@unique([amendmentId, serviceMasterCode, shiftType])
  @@index([amendmentId])
  @@map("service_master_rates")
}

/// Tier 2 service code master — an Activity recipe or an R1 material BOM.
model ServiceCode {
  id                 Int                 @id @default(autoincrement())
  amendmentId        Int                 @map("amendment_id")
  code               String              @db.VarChar(50)
  description        String
  category           ServiceCodeCategory @default(ACTIVITY)
  uom                String              @db.VarChar(20)
  materialMarkupPct  Decimal             @default(0) @map("material_markup_pct") @db.Decimal(5, 4)
  calculatedUnitRate Decimal             @default(0) @map("calculated_unit_rate") @db.Decimal(12, 4)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  amendment       ContractAmendment         @relation(fields: [amendmentId], references: [id])
  labourItems     ServiceCodeLabourItem[]
  materialItems   ServiceCodeMaterialItem[]
  jobServiceCodes JobServiceCode[]
  invoiceItems    InvoiceItem[]

  @@unique([amendmentId, code])
  @@index([amendmentId])
  @@map("service_code")
}

model ServiceCodeLabourItem {
  id                  Int     @id @default(autoincrement())
  serviceCodeId       Int     @map("service_code_id")
  serviceMasterRateId Int     @map("service_master_rate_id")
  crewQuantity        Decimal @default(1) @map("crew_quantity") @db.Decimal(8, 2)
  hoursPerUnit        Decimal @map("hours_per_unit") @db.Decimal(10, 4)
  lineSubtotal        Decimal @map("line_subtotal") @db.Decimal(12, 4)

  serviceCode       ServiceCode       @relation(fields: [serviceCodeId], references: [id])
  serviceMasterRate ServiceMasterRate @relation(fields: [serviceMasterRateId], references: [id])

  @@unique([serviceCodeId, serviceMasterRateId])
  @@index([serviceCodeId])
  @@map("service_code_labour_item")
}

model ServiceCodeMaterialItem {
  id            Int     @id @default(autoincrement())
  serviceCodeId Int     @map("service_code_id")
  itemCode      String? @map("item_code") @db.VarChar(50)
  description   String
  supplierName  String? @map("supplier_name") @db.VarChar(150)
  unitCost      Decimal @map("unit_cost") @db.Decimal(12, 4)
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  uom           String  @default("EA") @db.VarChar(20)
  subtotalCost  Decimal @map("subtotal_cost") @db.Decimal(12, 4)

  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])

  @@index([serviceCodeId])
  @@map("service_code_material_item")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model Project {
  id          Int       @id @default(autoincrement())
  contractId  Int       @map("contract_id")
  amendmentId Int       @map("amendment_id")
  code        String    @unique @db.VarChar(50)
  year        Int       @db.SmallInt
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?

  contract  Contract          @relation(fields: [contractId], references: [id])
  amendment ContractAmendment @relation(fields: [amendmentId], references: [id])
  jobs      Job[]

  @@index([contractId])
  @@index([amendmentId])
  @@map("project")
}

/// Admin-editable job status catalogue (Phase 15 item 5).
///
/// Replaces the `job_status_enum` PostgreSQL enum: statuses are rows so an
/// administrator can rename them, move them in the pipeline, change which
/// quantities they allow, and add new ones - without a deploy. `key` is the
/// stable identity that `job.status` stores and every transition names; the
/// label is free text.
model JobStatusDefinition {
  key       String @id @db.VarChar(40)
  label     String @db.VarChar(80)
  /// Pipeline position; lower is earlier. Unique so the order is total.
  sortOrder Int    @unique @map("sort_order")

  /// No further transition is possible from a terminal status. At least one
  /// status in the catalogue must remain terminal; the admin API enforces it.
  isTerminal Boolean @default(false) @map("is_terminal")
  /// Planned quantities may be edited while a job is in this status.
  editablePlanned Boolean @default(false) @map("editable_planned")
  /// Actual quantities may be recorded while a job is in this status.
  editableActuals Boolean @default(false) @map("editable_actuals")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs            Job[]
  transitionsFrom JobTransitionDefinition[] @relation("JobTransitionFrom")
  transitionsTo   JobTransitionDefinition[] @relation("JobTransitionTo")

  @@map("job_statuses")
}

/// One legal move between two statuses. Cancellation is an ordinary edge, so
/// which statuses may be cancelled - and who may do it - is editable data.
model JobTransitionDefinition {
  id         Int    @id @default(autoincrement())
  fromKey    String @map("from_key") @db.VarChar(40)
  toKey      String @map("to_key") @db.VarChar(40)
  /// RBAC capability required to perform the move, e.g. 'job.transition.execute'.
  permission String @db.VarChar(80)
  /// Human-readable justification, surfaced in the UI and 403 responses.
  reason     String

  from JobStatusDefinition @relation("JobTransitionFrom", fields: [fromKey], references: [key], onDelete: Cascade)
  to   JobStatusDefinition @relation("JobTransitionTo", fields: [toKey], references: [key], onDelete: Cascade)

  @@unique([fromKey, toKey])
  @@index([toKey])
  @@map("job_transitions")
}

model Job {
  id              Int         @id @default(autoincrement())
  projectId       Int         @map("project_id")
  /// Null means "inherit the project's amendment" (Phase 3 resolution rule).
  amendmentId     Int?        @map("amendment_id")
  supervisorId    Int?        @map("supervisor_id")
  clientContactId Int?        @map("client_contact_id")
  /// A `job_statuses.key`. The foreign key is what makes it impossible for a
  /// status in use to disappear from the catalogue.
  status          String      @default("01. Scoping") @db.VarChar(40)
  priority        JobPriority @default(P3_ROUTINE_NORMAL)

  workOrder                 String?   @map("work_order") @db.VarChar(100)
  workOrderReceivedDate     DateTime? @map("work_order_received_date") @db.Date
  purchaseOrder             String?   @map("purchase_order") @db.VarChar(100)
  purchaseOrderReceivedDate DateTime? @map("purchase_order_received_date") @db.Date
  plannedStartDate          DateTime? @map("planned_start_date") @db.Date
  plannedEndDate            DateTime? @map("planned_end_date") @db.Date
  actualStartDate           DateTime? @map("actual_start_date") @db.Date
  actualEndDate             DateTime? @map("actual_end_date") @db.Date
  area                      String?   @db.VarChar(100)
  description               String?

  project       Project            @relation(fields: [projectId], references: [id])
  amendment     ContractAmendment? @relation(fields: [amendmentId], references: [id])
  supervisor    Employee?          @relation("JobSupervisor", fields: [supervisorId], references: [id])
  clientContact Contact?           @relation(fields: [clientContactId], references: [id])
  statusRef     JobStatusDefinition @relation(fields: [status], references: [key])
  serviceCodes  JobServiceCode[]
  assignments   JobAssignment[]
  invoices      Invoice[]
  timesheetEntries TimesheetEntry[]

  @@index([projectId])
  @@index([amendmentId])
  @@index([supervisorId])
  @@index([status])
  @@map("job")
}

model JobServiceCode {
  id              Int     @id @default(autoincrement())
  jobId           Int     @map("job_id")
  serviceCodeId   Int     @map("service_code_id")
  plannedQuantity Decimal @default(0) @map("planned_quantity") @db.Decimal(10, 2)
  actualQuantity  Decimal @default(0) @map("actual_quantity") @db.Decimal(10, 2)
  /// Immutable pricing snapshot taken at scoping time.
  appliedRate     Decimal @map("applied_rate") @db.Decimal(12, 4)
  plannedSubtotal Decimal @map("planned_subtotal") @db.Decimal(12, 2)
  actualSubtotal  Decimal @default(0) @map("actual_subtotal") @db.Decimal(12, 2)
  /// Phase 8 item 6: the inputs that produced `appliedRate`, captured at scoping
  /// time - service code, markup, every labour and material line, and the
  /// amendment's cost parameters. `appliedRate` makes the number reproducible;
  /// this makes it defensible. Null only on rows backfilled before the column
  /// existed, and on backfilled rows it carries `"backfilled": true`.
  snapshotSource  Json?   @map("snapshot_source") @db.JsonB

  job         Job         @relation(fields: [jobId], references: [id])
  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])
  timesheetEntries TimesheetEntry[]

  @@unique([jobId, serviceCodeId])
  @@index([jobId])
  @@index([serviceCodeId])
  @@map("job_service_code")
}

model JobAssignment {
  id           Int       @id @default(autoincrement())
  jobId        Int       @map("job_id")
  employeeId   Int       @map("employee_id")
  role         String?   @db.VarChar(100)
  assignedDate DateTime? @map("assigned_date") @db.Date

  job      Job      @relation(fields: [jobId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([jobId])
  @@index([employeeId])
  /// Phase 8 item 1: one crew slot per person per job, enforced by the database.
  /// Every sibling join table already had this; `job_assignment` did not, and the
  /// Phase 7 crew screen made a duplicate one click away.
  @@unique([jobId, employeeId], map: "job_assignment_job_employee_key")
  @@map("job_assignment")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id            Int           @id @default(autoincrement())
  jobId         Int           @map("job_id")
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  issueDate     DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(DRAFT)
  /// Legacy pre-VAT column: equals `totalWithTax` for new invoices.
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)

  // --- VAT (migration 0002) ---------------------------------------------
  /// Sum of rounded line subtotals, VAT exclusive.
  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(14, 2)
  /// VAT fraction snapshotted from the amendment at generation time.
  taxRate        Decimal @default(0.15) @map("tax_rate") @db.Decimal(5, 4)
  /// subtotalAmount x effective tax rate, rounded to cents.
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// subtotalAmount + taxAmount. The amount payable.
  totalWithTax   Decimal @default(0) @map("total_with_tax") @db.Decimal(14, 2)
  // -----------------------------------------------------------------------

  notes String?

  job   Job           @relation(fields: [jobId], references: [id])
  items InvoiceItem[]

  @@index([jobId])
  @@index([status])
  @@map("invoice")
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int     @map("invoice_id")
  serviceCodeId  Int     @map("service_code_id")
  description    String?
  billedQuantity Decimal @default(1) @map("billed_quantity") @db.Decimal(10, 2)
  /// Immutable pricing snapshot copied from `job_service_code.applied_rate`.
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 4)
  subtotal       Decimal @db.Decimal(12, 2)

  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  serviceCode ServiceCode @relation(fields: [serviceCodeId], references: [id])

  @@index([invoiceId])
  @@index([serviceCodeId])
  @@map("invoice_item")
}

// ---------------------------------------------------------------------------
// Timesheets (Phase 16)
//
// The cost side of a job. Entirely separate from operations and billing: hours
// are never quantities, and nothing here writes `job_service_code`, actuals or
// invoices. Job and finance screens read the result; the module only supplies
// the cost input.
// ---------------------------------------------------------------------------

/// One employee's week. The union `(employee, week)` is the natural key, and
/// the row is the unit of approval: approving it freezes every line's cost.
model Timesheet {
  id          Int             @id @default(autoincrement())
  employeeId  Int             @map("employee_id")
  /// Monday. `period_end` is the following Sunday, derived by the server.
  periodStart DateTime        @map("period_start") @db.Date
  periodEnd   DateTime        @map("period_end") @db.Date
  status      TimesheetStatus @default(DRAFT)
  notes       String?

  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedById Int?      @map("submitted_by_id")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById   Int?      @map("decided_by_id")
  decisionNote  String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee    Employee         @relation(fields: [employeeId], references: [id])
  submittedBy AppUser?         @relation("TimesheetSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   AppUser?         @relation("TimesheetDecidedBy", fields: [decidedById], references: [id])
  entries     TimesheetEntry[]

  @@unique([employeeId, periodStart])
  @@index([status])
  @@index([employeeId])
  @@map("timesheet")
}

/// One line: hours on one job, on one day, of one labour type and shift.
///
/// `cost_rate` / `cost_amount` / `rate_snapshot` are null while DRAFT and are
/// frozen at approval, so a later rate-card edit cannot rewrite an approved
/// week. See ADR-012.
model TimesheetEntry {
  id               Int       @id @default(autoincrement())
  timesheetId      Int       @map("timesheet_id")
  jobId            Int       @map("job_id")
  /// Optional deliverable link: lets hours attribute to a specific line of the
  /// job, and pre-fills the labour type from that deliverable's recipe.
  jobServiceCodeId Int?      @map("job_service_code_id")
  workDate         DateTime  @map("work_date") @db.Date
  labourType       String    @map("labour_type") @db.VarChar(100)
  shiftType        ShiftType @default(NT) @map("shift_type")
  hours            Decimal   @db.Decimal(6, 2)
  isBillable       Boolean   @default(true) @map("is_billable")
  notes            String?

  /// A manual cost-rate override and its justification (requires
  /// `timesheet.override`). Stored so the override survives edits and is applied
  /// when approval freezes the line.
  costRateOverride Decimal? @map("cost_rate_override") @db.Decimal(12, 4)
  overrideReason   String?  @map("override_reason")

  /// Frozen at approval: the resolved rate snapshot (`{ capturedAt, source,
  /// costRate, employeeId }`) and the derived cost rate/amount. Null while the
  /// line is editable.
  rateSnapshot Json?    @map("rate_snapshot") @db.JsonB
  costRate     Decimal? @map("cost_rate") @db.Decimal(12, 4)
  costAmount   Decimal? @map("cost_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  timesheet      Timesheet       @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id])
  jobServiceCode JobServiceCode? @relation(fields: [jobServiceCodeId], references: [id])

  @@index([timesheetId])
  @@index([jobId, workDate])
  @@map("timesheet_entry")
}

// ---------------------------------------------------------------------------
// Authentication & RBAC (introduced in Phase 1)
// ---------------------------------------------------------------------------

/// Every application user is linked 1-to-1 to an `employee` record. There are
/// no accounts without an employee, and no employees may hold two accounts.
model AppUser {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @unique @map("employee_id")
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  /// Bumped on password change / forced logout to invalidate old tokens.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Profile avatar (Phase 15). Processed on upload to a 256x256 WebP, so the
  /// bytes are tens of KB and safe to keep inline. They live on the *account*,
  /// not the employee: an avatar identifies a login, and an avatar column on
  /// `employee` would suggest employees without accounts can have one.
  avatarBytes     Bytes?    @map("avatar_bytes")
  avatarMime      String?   @map("avatar_mime") @db.VarChar(64)
  /// Doubles as the cache-buster: the client appends it to the image URL.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)

  employee Employee      @relation(fields: [employeeId], references: [id])
  roles    AppUserRole[]
  auditEntries AuditLog[]
  timesheetsSubmitted Timesheet[] @relation("TimesheetSubmittedBy")
  timesheetsDecided   Timesheet[] @relation("TimesheetDecidedBy")
  conversationMembers ConversationMember[]
  messages            Message[]            @relation("MessageSender")

  @@index([isActive])
  @@map("app_user")
}

model AppRole {
  id          Int      @id @default(autoincrement())
  /// Stable machine key, e.g. 'administrator', 'commercial_qs'.
  key         String   @unique @db.VarChar(64)
  name        String   @unique @db.VarChar(100)
  description            String?
  permissionsCustomized Boolean  @default(false) @map("permissions_customized")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users       AppUserRole[]
  permissions RolePermission[]

  @@map("app_role")
}

// ---------------------------------------------------------------------------
// Audit log (introduced in Phase 5)
// ---------------------------------------------------------------------------

/// Append-only record of every write to application data.
///
/// Actor fields are denormalised deliberately: `actorUserId` is cleared when an
/// account is deleted, but the log must keep naming who acted. `before`/`after`
/// hold the row as JSON, and on an UPDATE `after` carries only the fields that
/// actually changed, so a reviewer sees the edit rather than the whole row.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actorUserId     Int?    @map("actor_user_id")
  actorEmail      String? @map("actor_email") @db.VarChar(255)
  actorEmployeeId Int?    @map("actor_employee_id")

  action    String @db.VarChar(16)
  model     String @db.VarChar(64)
  /// Primary key of the affected row, or a comma-separated list for bulk writes.
  recordId  String? @map("record_id")
  summary   String?

  before         Json?    @map("before")
  after          Json?    @map("after")
  changedFields  String[] @map("changed_fields")

  requestId String? @map("request_id") @db.VarChar(64)
  route     String? @db.VarChar(255)
  method    String? @db.VarChar(10)

  actor     AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([model])
  @@index([actorUserId])
  @@index([model, recordId])
  @@map("audit_log")
}

model AppUserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy Int?     @map("assigned_by")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("app_user_role")
}

/// A single named capability, e.g. 'contract:write' or 'job:transition:invoiced'.
model Permission {
  id          Int     @id @default(autoincrement())
  /// Dotted machine key, e.g. 'job.transition.submit'.
  key         String  @unique @db.VarChar(100)
  description String?
  /// Workflow grouping used by the Phase 5 permissions matrix UI.
  category    String  @db.VarChar(64)

  roles RolePermission[]

  @@index([category])
  @@map("permission")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Chat (Phase 17)
//
// Step 1 is person-to-person only. Membership is the read boundary: there is no
// global "read all messages" permission, because visibility is a fact about the
// row, not a capability. See ADR-013.
// ---------------------------------------------------------------------------

/// A conversation is a container. Only `DM` is created today; the other kinds
/// exist so job/project channels are additive later rather than a rewrite.
model Conversation {
  id            Int              @id @default(autoincrement())
  kind          ConversationKind @default(DM)
  /// Stable dedupe key for a DM: the two account ids sorted, "min:max". NULL for
  /// kinds that are not deduplicated this way.
  dmKey         String?          @unique @map("dm_key") @db.VarChar(64)
  title         String?          @db.VarChar(150)
  /// Denormalised from the newest message so the list is one query, not an
  /// aggregate per row.
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@map("conversation")
}

model ConversationMember {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  userId         Int       @map("user_id")
  /// Everything up to here has been read; drives the unread badge. Null means
  /// "nothing read yet".
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_member")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  body           String
  /// Idempotency key: a retried send returns the original, not a duplicate.
  clientToken    String?   @map("client_token") @db.VarChar(64)
  /// Present but unused in step 1, so later edit/delete needs no ALTER.
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       AppUser      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientToken])
  @@index([conversationId, createdAt, id])
  @@map("message")
}
