{
  "name": "@openerp/server",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "OpenERP REST API: Fastify + Prisma, auth, RBAC, pricing, operations and billing.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bundle": "node build.mjs",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --exclude \"**/commercial.integration.test.ts\" --exclude \"**/billing.integration.test.ts\" --exclude \"**/operations.integration.test.ts\"",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@openerp/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
